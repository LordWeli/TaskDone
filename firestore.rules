rules_version = '2';

// Each user can read and write only their own data under users/{uid}.
// Everything else is denied (no other match blocks exist).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDayOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isNonNegative(v) {
      return v is number && v >= 0;
    }

    function validTask(t) {
      return t.keys().hasOnly(['title', 'createdAt', 'completedAt', 'xpAwarded'])
        && t.keys().hasAll(['title', 'createdAt', 'completedAt', 'xpAwarded'])
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 200
        && t.createdAt is number
        && (t.completedAt == null || t.completedAt is number)
        && isNonNegative(t.xpAwarded);
    }

    function validStats(s) {
      return s.keys().hasOnly([
          'totalXp', 'level', 'currentStreak', 'longestStreak', 'lastActiveDay', 'badges',
          'tasksCompleted', 'activeDayCompletions', 'streakBefore', 'perfectDay'])
        && s.keys().hasAll(['totalXp', 'level', 'currentStreak', 'longestStreak', 'lastActiveDay', 'badges'])
        && isNonNegative(s.totalXp)
        && s.level is number && s.level >= 1
        && isNonNegative(s.currentStreak)
        && isNonNegative(s.longestStreak)
        && isDayOrNull(s.lastActiveDay)
        && s.badges is map
        && (!('tasksCompleted' in s) || isNonNegative(s.tasksCompleted))
        && (!('activeDayCompletions' in s) || isNonNegative(s.activeDayCompletions))
        && (!('streakBefore' in s) || s.streakBefore == null || s.streakBefore is map)
        && (!('perfectDay' in s) || s.perfectDay == null || s.perfectDay is map);
    }

    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTask(request.resource.data);
    }

    match /users/{uid}/stats/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && docId == 'summary' && validStats(request.resource.data);
    }
  }
}
